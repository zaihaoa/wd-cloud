<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wd.system.basic.mapper.DictionaryItemMapper">

    <sql id="PageCondition">
        <where>
            <if test="param.dictionaryCode != null and param.dictionaryCode != ''">
                AND `dictionary_code` = #{param.dictionaryCode}
            </if>
            <if test="param.itemCode != null and param.itemCode != ''">
                AND `item_code` LIKE concat('%', #{param.itemCode}, '%')
            </if>
            <if test="param.itemDesc != null and param.itemDesc != ''">
                AND `item_desc` LIKE concat('%', #{param.itemDesc}, '%')
            </if>
            <if test="param.remark != null and param.remark != ''">
                AND `remark` LIKE concat('%', #{param.remark}, '%')
            </if>
            <if test="param.status != null and param.status != ''">
                AND `status` = #{param.status}
            </if>
            AND `delete_flag` = 0
        </where>
    </sql>

    <select id="pageCount" resultType="int">
        SELECT COUNT(*)
        FROM sys_dictionary_item
        <include refid="PageCondition"/>
    </select>

    <select id="pageList" resultType="com.wd.system.basic.domain.dto.DictionaryItemPageDTO">
        SELECT `id`,
               `dictionary_code` AS "dictionaryCode",
               `item_code` AS "itemCode",
               `item_desc` AS "itemDesc",
               `sort_number` AS "sortNumber",
               `status`,
               `remark`,
               `create_user_id` AS "createUserId",
               `update_user_id` AS "updateUserId",
               `create_time` AS "createTime",
               `update_time` AS "updateTime"
        FROM sys_dictionary_item
        <include refid="PageCondition"/>

        ORDER BY
        <choose>
            <when test="param.sort == 'id'">`id`</when>
            <when test="param.sort == 'dictionaryCode'">`dictionary_code`</when>
            <when test="param.sort == 'itemCode'">`item_code`</when>
            <when test="param.sort == 'itemDesc'">`item_desc`</when>
            <when test="param.sort == 'sortNumber'">`sort_number`</when>
            <when test="param.sort == 'status'">`status`</when>
            <when test="param.sort == 'remark'">`remark`</when>
            <when test="param.sort == 'createUserId'">`create_user_id`</when>
            <when test="param.sort == 'updateUserId'">`update_user_id`</when>
            <when test="param.sort == 'createTime'">`create_time`</when>
            <when test="param.sort == 'updateTime'">`update_time`</when>
            <otherwise>`id`</otherwise>
        </choose>
        <choose>
            <when test="param.order != null and param.order.equalsIgnoreCase('DESC')">DESC</when>
            <otherwise>ASC</otherwise>
        </choose>
        , `id` ASC
        <bind name="limitStart" value="(param.current lte 1) ? 0 : ((param.current - 1) * param.size)"/>
        LIMIT #{limitStart}, #{param.size}
    </select>
</mapper>
